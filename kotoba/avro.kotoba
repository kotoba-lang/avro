;; Honest Kotoba v1: Avro Object Container File identification only.
;; Magic Obj (bytes 0-2) plus the one-byte version (byte 3).
;; Does not parse JSON schema, codec name, sync marker, or data blocks.
;; No writer, no reader engine, no FFI. i64-v1 / wasm32-kotoba-v1.

(ns avro.header (:export [main]))

;; One literal per fixture byte. checks.sh compares these to
;; fixtures/tiny-header.avro (Obj + version 1).
(defn fixture-byte [i]
  (if (= i 0) 79
    (if (= i 1) 98
      (if (= i 2) 106
        (if (= i 3) 1
          0)))))

(defn magic-ok []
  (and (= (fixture-byte 0) 79)
       (= (fixture-byte 1) 98)
       (= (fixture-byte 2) 106)))

(defn version []
  (fixture-byte 3))

;; Returns version when magic is Obj, otherwise 0.
(defn main []
  (if (magic-ok)
    (version)
    0))
